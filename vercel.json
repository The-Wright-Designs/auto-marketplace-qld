{
  "crons": [
    {
      "path": "/api/cron/tender-close",
      "schedule": "0 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(|about|contact|terms-and-conditions|privacy-policy|for-dealers)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/dealer-portal/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
